# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
env/
.env/
.venv/

# ── Environment variables / secrets ───────────────────────────────────────────
.env
.env.local
*.env

# ── Hugging Face model cache (large, no need to commit) ───────────────────────
.cache/
models/
*.bin
*.safetensors
*.pt
*.pth

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Test artifacts ────────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# ── Generated outputs (don't commit exported reports) ─────────────────────────
*.pdf
*.xlsx
exports/

# ── Large data files ──────────────────────────────────────────────────────────
*.parquet
*.csv
!tests/sample_data/*.csv
